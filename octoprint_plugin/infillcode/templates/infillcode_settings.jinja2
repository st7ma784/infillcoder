<form class="form-horizontal">

  <legend>Core</legend>

  <div class="control-group">
    <label class="control-label">DB Path</label>
    <div class="controls">
      <input type="text" class="input-block-level"
             data-bind="value: settings.plugins.infillcode.db_path"
             placeholder="/path/to/companion.db"/>
      <span class="help-block">Absolute path to the companion SQLite database.</span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Snapshot URL</label>
    <div class="controls">
      <input type="text" class="input-block-level"
             data-bind="value: settings.plugins.infillcode.snapshot_url"
             placeholder="http://localhost/webcam/?action=snapshot"/>
      <span class="help-block">OctoPrint webcam snapshot endpoint.</span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Nominal Spacing (mm)</label>
    <div class="controls">
      <input type="number" step="0.01" min="0"
             data-bind="value: settings.plugins.infillcode.nominal_spacing_mm"/>
      <span class="help-block">Leave 0 to auto-detect from spacing data.</span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Spacing Tolerance</label>
    <div class="controls">
      <input type="number" step="0.01" min="0" max="1"
             data-bind="value: settings.plugins.infillcode.spacing_tolerance"/>
      <span class="help-block">Fractional tolerance for gap classification (default 0.15).</span>
    </div>
  </div>

  <legend>Workflow Automation</legend>

  <div class="control-group">
    <label class="control-label">Auto-process <code>.aw.gcode</code></label>
    <div class="controls">
      <input type="checkbox"
             data-bind="checked: settings.plugins.infillcode.auto_process_aw_gcode"/>
      <span class="help-block">
        When a file named <code>*.aw.gcode</code> is uploaded, automatically run the
        InfillCode encode pipeline and save the result as <code>*.gcode</code>.
        Requires DB path to be set.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Scan bed on startup</label>
    <div class="controls">
      <input type="checkbox"
             data-bind="checked: settings.plugins.infillcode.auto_scan_on_startup"/>
      <span class="help-block">
        15 s after OctoPrint starts, take a webcam snapshot and attempt to decode any
        InfillCode fingerprint on the bed.  If found and auto-resume is enabled, a
        resume file is generated automatically.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Mid-print check interval (%)</label>
    <div class="controls">
      <input type="number" step="5" min="0" max="50"
             data-bind="value: settings.plugins.infillcode.fingerprint_check_interval"/>
      <span class="help-block">
        During a print, verify the fingerprint every N % of progress (e.g. 25 = check
        at 25 %, 50 %, 75 %).  Set to 0 to disable.  Failed decodes update the health
        score in the sidebar.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Auto-pause after N consecutive failures</label>
    <div class="controls">
      <input type="number" step="1" min="0" max="20"
             data-bind="value: settings.plugins.infillcode.auto_pause_consecutive_failures"/>
      <span class="help-block">
        Pause the printer automatically if fingerprint checks fail this many times in a
        row.  Set to 0 to disable (recommended default).  Note: layers with very dense
        infill or no encoded infill may legitimately fail — use a higher threshold (e.g.
        3–5) to avoid false alarms on those layers.
      </span>
    </div>
  </div>

  <legend>Resume GCode</legend>

  <div class="control-group">
    <label class="control-label">Auto-generate resume on failure</label>
    <div class="controls">
      <input type="checkbox"
             data-bind="checked: settings.plugins.infillcode.auto_resume"/>
      <span class="help-block">
        When a failure (or startup scan) is detected, automatically generate a resume
        GCode file starting from the next layer and save it to the uploads folder.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Z-hop (mm)</label>
    <div class="controls">
      <input type="number" step="0.1" min="0" max="20"
             data-bind="value: settings.plugins.infillcode.z_hop_mm"/>
      <span class="help-block">Nozzle lift at the start of the resume sequence (default 2.0 mm).</span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Prime length (mm)</label>
    <div class="controls">
      <input type="number" step="1" min="0" max="100"
             data-bind="value: settings.plugins.infillcode.prime_length_mm"/>
      <span class="help-block">Purge extrusion before resuming layers (default 20 mm).</span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Park position (X, Y mm)</label>
    <div class="controls">
      <div class="input-append">
        <span class="add-on">X</span>
        <input type="number" step="1" min="-1" style="width:80px"
               data-bind="value: settings.plugins.infillcode.park_x"/>
        <span class="add-on" style="margin-left:8px">Y</span>
        <input type="number" step="1" min="-1" style="width:80px"
               data-bind="value: settings.plugins.infillcode.park_y"/>
      </div>
      <span class="help-block">
        Move the nozzle to this XY position <em>before</em> heating up, so heat-soak
        ooze does not drip onto the stalled print. Set to <code>-1</code> on either
        axis to disable (nozzle stays put during heat-up). A corner off the print
        area, e.g. <code>X0 Y0</code>, works well on most printers.
      </span>
    </div>
  </div>

</form>
